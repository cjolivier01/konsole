#!/usr/bin/make -f

DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
# Keep transitive shared-library resolution stable on hosts that also have
# locally installed GLib/GIO builds under /usr/local.
export DEB_LDFLAGS_MAINT_APPEND = -Wl,-rpath-link,/usr/local/lib/$(DEB_HOST_MULTIARCH) -Wl,-rpath-link,/usr/lib/$(DEB_HOST_MULTIARCH) -Wl,-rpath-link,/lib/$(DEB_HOST_MULTIARCH)

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=OFF -DENABLE_PLUGIN_SSHMANAGER=ON

override_dh_auto_test:
	# The upstream test suite is intentionally disabled for package builds.
	:

execute_after_dh_fixperms-arch:
	chmod -x $(CURDIR)/debian/konsole/usr/share/kio/servicemenus/konsolerun.desktop
